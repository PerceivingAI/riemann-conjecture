{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlon/riemann-conjecture/docs/contracts/rh-weil-certificate-v1.json",
  "title": "RH Weil exact interval certificate format v1",
  "description": "Closed syntax contract for exact rational interval certificates. PASS semantics are profile-specific: exact interval LDL for scalar/digamma profiles, or verifier-derived Legendre complement plus exact Schur congruence/Gershgorin positivity for explicitly whitelisted exact-prime support/dimension pairs.",
  "type": "object",
  "required": [
    "format",
    "claim",
    "claim_profile",
    "support_T",
    "basis",
    "parity_sector",
    "dimension",
    "constants",
    "matrix",
    "tail_bound",
    "generator_metadata"
  ],
  "properties": {
    "format": {
      "const": "rh-weil-certificate-v1"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_profile": {
      "enum": [
        "synthetic_matrix",
        "digamma_finite_block",
        "exact_prime_legendre_schur"
      ]
    },
    "support_T": {
      "$ref": "#/$defs/support"
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "parity_sector": {
      "enum": [
        "even",
        "odd",
        "both"
      ]
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "constants": {
      "$ref": "#/$defs/constants"
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "tail_bound": {
      "$ref": "#/$defs/tailBound"
    },
    "generator_metadata": {
      "$ref": "#/$defs/generatorMetadata"
    },
    "schur_proof": {
      "$ref": "#/$defs/schurProof"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_profile": {
            "const": "synthetic_matrix"
          }
        },
        "required": [
          "claim_profile"
        ]
      },
      "then": {
        "properties": {
          "constants": {
            "maxProperties": 0
          },
          "tail_bound": {
            "$ref": "#/$defs/exactScalarIdentityTail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_profile": {
            "const": "digamma_finite_block"
          }
        },
        "required": [
          "claim_profile"
        ]
      },
      "then": {
        "properties": {
          "basis": {
            "properties": {
              "domain": {
                "const": "[-T, T]"
              }
            }
          },
          "constants": {
            "required": [
              "m0_digamma"
            ],
            "minProperties": 1,
            "maxProperties": 1
          },
          "tail_bound": {
            "$ref": "#/$defs/nonnegativeDigammaTail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_profile": {
            "const": "exact_prime_legendre_schur"
          }
        },
        "required": ["claim_profile"]
      },
      "then": {
        "required": ["schur_proof"],
        "properties": {
          "basis": {
            "properties": {
              "type": {"const": "legendre"},
              "dimension": {"enum": [32, 40, 48, 56, 68]},
              "domain": {"const": "[-1, 1]"}
            }
          },
          "parity_sector": {"const": "both"},
          "dimension": {"enum": [32, 40, 48, 56, 68]},
          "constants": {
            "required": ["c2", "c_T", "rho_R"],
            "minProperties": 3,
            "maxProperties": 3
          },
          "tail_bound": {
            "$ref": "#/$defs/legendreSchurTail"
          }
        },
        "oneOf": [
          {
            "properties": {
              "support_T": {
                "properties": {
                  "num": {"const": "7"},
                  "den": {"const": "20"},
                  "frac": {"const": "7/20"}
                }
              },
              "dimension": {"const": 32},
              "basis": {"properties": {"dimension": {"const": 32}}},
              "tail_bound": {"properties": {"harmonic_index": {"const": 32}}}
            }
          },
          {
            "properties": {
              "support_T": {
                "properties": {
                  "num": {"const": "2"},
                  "den": {"const": "5"},
                  "frac": {"const": "2/5"}
                }
              },
              "dimension": {"const": 40},
              "basis": {"properties": {"dimension": {"const": 40}}},
              "tail_bound": {"properties": {"harmonic_index": {"const": 40}}}
            }
          },
          {
            "properties": {
              "support_T": {
                "properties": {
                  "num": {"const": "17"},
                  "den": {"const": "40"},
                  "frac": {"const": "17/40"}
                }
              },
              "dimension": {"const": 48},
              "basis": {"properties": {"dimension": {"const": 48}}},
              "tail_bound": {"properties": {"harmonic_index": {"const": 48}}}
            }
          },
          {
            "properties": {
              "support_T": {
                "properties": {
                  "num": {"const": "9"},
                  "den": {"const": "20"},
                  "frac": {"const": "9/20"}
                }
              },
              "dimension": {"const": 56},
              "basis": {"properties": {"dimension": {"const": 56}}},
              "tail_bound": {"properties": {"harmonic_index": {"const": 56}}}
            }
          },
          {
            "properties": {
              "support_T": {
                "properties": {
                  "num": {"const": "19"},
                  "den": {"const": "40"},
                  "frac": {"const": "19/40"}
                }
              },
              "dimension": {"const": 68},
              "basis": {"properties": {"dimension": {"const": 68}}},
              "tail_bound": {"properties": {"harmonic_index": {"const": 68}}}
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "canonicalInteger": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "positiveInteger": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "rational": {
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "den": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": [
        "lo_num",
        "lo_den",
        "hi_num",
        "hi_den"
      ],
      "properties": {
        "lo_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "lo_den": {
          "$ref": "#/$defs/positiveInteger"
        },
        "hi_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "hi_den": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": [
        "num",
        "den",
        "frac"
      ],
      "properties": {
        "num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "den": {
          "$ref": "#/$defs/positiveInteger"
        },
        "frac": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)/[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "required": [
        "type",
        "dimension",
        "domain"
      ],
      "properties": {
        "type": {
          "enum": [
            "legendre",
            "chebyshev",
            "monomial"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "domain": {
          "enum": [
            "[-T, T]",
            "[-1, 1]"
          ]
        }
      },
      "additionalProperties": false
    },
    "constants": {
      "type": "object",
      "properties": {
        "log2": {
          "$ref": "#/$defs/interval"
        },
        "sqrt2": {
          "$ref": "#/$defs/interval"
        },
        "pi": {
          "$ref": "#/$defs/interval"
        },
        "euler_gamma": {
          "$ref": "#/$defs/interval"
        },
        "tau": {
          "$ref": "#/$defs/interval"
        },
        "c2": {
          "$ref": "#/$defs/interval"
        },
        "c_T": {
          "$ref": "#/$defs/interval"
        },
        "m0_digamma": {
          "$ref": "#/$defs/interval"
        },
        "rho_R": {
          "$ref": "#/$defs/interval"
        }
      },
      "additionalProperties": false
    },
    "matrixEntry": {
      "type": "object",
      "required": [
        "row",
        "col",
        "lo_num",
        "lo_den",
        "hi_num",
        "hi_den"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "lo_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "lo_den": {
          "$ref": "#/$defs/positiveInteger"
        },
        "hi_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "hi_den": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": "object",
      "required": [
        "dimension",
        "entries"
      ],
      "properties": {
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/matrixEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "exactMatrixEntry": {
      "type": "object",
      "required": ["row", "col", "num", "den"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0},
        "num": {"$ref": "#/$defs/canonicalInteger"},
        "den": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": false
    },
    "exactMatrix": {
      "type": "object",
      "required": ["dimension", "entries"],
      "properties": {
        "dimension": {"type": "integer", "minimum": 1},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/exactMatrixEntry"}
        }
      },
      "additionalProperties": false
    },
    "schurProof": {
      "type": "object",
      "required": ["residual_order", "GV", "G2", "GR", "even_witness", "odd_witness"],
      "properties": {
        "residual_order": {"const": 32},
        "GV": {"$ref": "#/$defs/matrix"},
        "G2": {"$ref": "#/$defs/matrix"},
        "GR": {"$ref": "#/$defs/matrix"},
        "even_witness": {"$ref": "#/$defs/exactMatrix"},
        "odd_witness": {"$ref": "#/$defs/exactMatrix"}
      },
      "additionalProperties": false
    },
    "legendreSchurTail": {
      "type": "object",
      "required": ["type", "harmonic_index", "factor"],
      "properties": {
        "type": {"const": "legendre_component_gram_schur"},
        "harmonic_index": {"enum": [32, 40, 48, 56, 68]},
        "factor": {"$ref": "#/$defs/rational"}
      },
      "additionalProperties": false
    },
    "exactScalarIdentityTail": {
      "type": "object",
      "required": [
        "type",
        "lambda"
      ],
      "properties": {
        "type": {
          "const": "exact_scalar_identity"
        },
        "lambda": {
          "$ref": "#/$defs/rational"
        }
      },
      "additionalProperties": false
    },
    "nonnegativeDigammaTail": {
      "type": "object",
      "required": [
        "type",
        "k_max",
        "first_omitted_k"
      ],
      "properties": {
        "type": {
          "const": "nonnegative_digamma_remainder"
        },
        "k_max": {
          "type": "integer",
          "minimum": 0
        },
        "first_omitted_k": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tailBound": {
      "oneOf": [
        {
          "$ref": "#/$defs/exactScalarIdentityTail"
        },
        {
          "$ref": "#/$defs/nonnegativeDigammaTail"
        },
        {
          "$ref": "#/$defs/legendreSchurTail"
        }
      ]
    },
    "generatorMetadata": {
      "type": "object",
      "required": [
        "generator",
        "script",
        "version",
        "git_commit",
        "git_dirty",
        "flint_version",
        "python_flint_version",
        "prec_bits",
        "timestamp_utc"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "flint_version": {
          "type": "string",
          "minLength": 1
        },
        "python_flint_version": {
          "type": "string",
          "minLength": 1
        },
        "prec_bits": {
          "type": "integer",
          "minimum": 32
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
        }
      },
      "additionalProperties": false
    }
  }
}
