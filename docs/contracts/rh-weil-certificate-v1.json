{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlon/riemann-conjecture/docs/contracts/rh-weil-certificate-v1.json",
  "title": "RH Weil exact interval certificate format v1",
  "description": "Closed syntax contract for exact rational interval certificates. PASS means exact interval LDL proves positivity after the verifier derives and absorbs the selected tail rule.",
  "type": "object",
  "required": [
    "format",
    "claim",
    "claim_profile",
    "support_T",
    "basis",
    "parity_sector",
    "dimension",
    "constants",
    "matrix",
    "tail_bound",
    "generator_metadata"
  ],
  "properties": {
    "format": {
      "const": "rh-weil-certificate-v1"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_profile": {
      "enum": [
        "synthetic_matrix",
        "digamma_finite_block"
      ]
    },
    "support_T": {
      "$ref": "#/$defs/support"
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "parity_sector": {
      "enum": [
        "even",
        "odd",
        "both"
      ]
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "constants": {
      "$ref": "#/$defs/constants"
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "tail_bound": {
      "$ref": "#/$defs/tailBound"
    },
    "generator_metadata": {
      "$ref": "#/$defs/generatorMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_profile": {
            "const": "synthetic_matrix"
          }
        },
        "required": [
          "claim_profile"
        ]
      },
      "then": {
        "properties": {
          "constants": {
            "maxProperties": 0
          },
          "tail_bound": {
            "$ref": "#/$defs/exactScalarIdentityTail"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_profile": {
            "const": "digamma_finite_block"
          }
        },
        "required": [
          "claim_profile"
        ]
      },
      "then": {
        "properties": {
          "basis": {
            "properties": {
              "domain": {
                "const": "[-T, T]"
              }
            }
          },
          "constants": {
            "required": [
              "m0_digamma"
            ],
            "minProperties": 1,
            "maxProperties": 1
          },
          "tail_bound": {
            "$ref": "#/$defs/nonnegativeDigammaTail"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "canonicalInteger": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "positiveInteger": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "rational": {
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "den": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": [
        "lo_num",
        "lo_den",
        "hi_num",
        "hi_den"
      ],
      "properties": {
        "lo_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "lo_den": {
          "$ref": "#/$defs/positiveInteger"
        },
        "hi_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "hi_den": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": [
        "num",
        "den",
        "frac"
      ],
      "properties": {
        "num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "den": {
          "$ref": "#/$defs/positiveInteger"
        },
        "frac": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)/[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "required": [
        "type",
        "dimension",
        "domain"
      ],
      "properties": {
        "type": {
          "enum": [
            "legendre",
            "chebyshev",
            "monomial"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "domain": {
          "enum": [
            "[-T, T]",
            "[-1, 1]"
          ]
        }
      },
      "additionalProperties": false
    },
    "constants": {
      "type": "object",
      "properties": {
        "log2": {
          "$ref": "#/$defs/interval"
        },
        "sqrt2": {
          "$ref": "#/$defs/interval"
        },
        "pi": {
          "$ref": "#/$defs/interval"
        },
        "euler_gamma": {
          "$ref": "#/$defs/interval"
        },
        "tau": {
          "$ref": "#/$defs/interval"
        },
        "c2": {
          "$ref": "#/$defs/interval"
        },
        "c_T": {
          "$ref": "#/$defs/interval"
        },
        "m0_digamma": {
          "$ref": "#/$defs/interval"
        }
      },
      "additionalProperties": false
    },
    "matrixEntry": {
      "type": "object",
      "required": [
        "row",
        "col",
        "lo_num",
        "lo_den",
        "hi_num",
        "hi_den"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "lo_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "lo_den": {
          "$ref": "#/$defs/positiveInteger"
        },
        "hi_num": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "hi_den": {
          "$ref": "#/$defs/positiveInteger"
        }
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": "object",
      "required": [
        "dimension",
        "entries"
      ],
      "properties": {
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/matrixEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "exactScalarIdentityTail": {
      "type": "object",
      "required": [
        "type",
        "lambda"
      ],
      "properties": {
        "type": {
          "const": "exact_scalar_identity"
        },
        "lambda": {
          "$ref": "#/$defs/rational"
        }
      },
      "additionalProperties": false
    },
    "nonnegativeDigammaTail": {
      "type": "object",
      "required": [
        "type",
        "k_max",
        "first_omitted_k"
      ],
      "properties": {
        "type": {
          "const": "nonnegative_digamma_remainder"
        },
        "k_max": {
          "type": "integer",
          "minimum": 0
        },
        "first_omitted_k": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tailBound": {
      "oneOf": [
        {
          "$ref": "#/$defs/exactScalarIdentityTail"
        },
        {
          "$ref": "#/$defs/nonnegativeDigammaTail"
        }
      ]
    },
    "generatorMetadata": {
      "type": "object",
      "required": [
        "generator",
        "script",
        "version",
        "git_commit",
        "git_dirty",
        "flint_version",
        "python_flint_version",
        "prec_bits",
        "timestamp_utc"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "flint_version": {
          "type": "string",
          "minLength": 1
        },
        "python_flint_version": {
          "type": "string",
          "minLength": 1
        },
        "prec_bits": {
          "type": "integer",
          "minimum": 32
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
        }
      },
      "additionalProperties": false
    }
  }
}
